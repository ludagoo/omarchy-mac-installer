#!/bin/bash
# Build the SmartRoom packages from ludagoo/omarchy-mac-pkgs into a signed
# local pacman repository "smartroom" (on an Arch Linux ARM aarch64 host):
#   smartroom/build-packages OUT [COMMIT]
# COMMIT defaults to the tip of omarchy-mac-pkgs smartroom/main. Packages are
# signed with the local SmartRoom package key (SMARTROOM_PKG_KEY, a gpg
# fingerprint in the builder's keyring; its secret never leaves the build host).
# OUT gets repo/ (packages, signatures, smartroom.db), key.asc and key.fpr.
#
# The files smartroom/room/prebuilt.sha256 pins (the room browser) are not
# built here: SMARTROOM_ROOM_PACKAGES is a directory that holds them, and each
# must match its pin. They are signed with the same key.
set -euo pipefail
here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
out=${1:?Usage: smartroom/build-packages OUT [COMMIT]}
commit=${2:-}
key=${SMARTROOM_PKG_KEY:?set SMARTROOM_PKG_KEY to the package signing key fingerprint}
[[ $(uname -m) == aarch64 ]] || { echo "build on aarch64" >&2; exit 1; }
src=$(mktemp -d); trap 'rm -rf "$src"' EXIT
git clone -q https://github.com/ludagoo/omarchy-mac-pkgs.git "$src/pkgs"
git -C "$src/pkgs" checkout -q "${commit:-origin/smartroom/main}"
commit=$(git -C "$src/pkgs" rev-parse HEAD)
date=$(TZ=UTC0 git -C "$src/pkgs" show -s --format=%cd --date=format-local:%Y%m%d HEAD)
mkdir -p "$out/repo"
packages=(smartroom-omarchy-helpers omarchy-mac-boot smartroom-boot-os smartroom-release)
# The edge branch also builds aura, linux-aurora and (when the pkgs branch has
# its recipe) mesa-aurora into this repo. They are long compiles.
# SMARTROOM_EDGE_BOOT_PACKAGES, a directory of already-built .pkg.tar.zst
# files, is copied in instead of compiling them again.
if [[ -d $src/pkgs/smartroom/pkgbuilds/aura ]]; then
  if [[ -n ${SMARTROOM_EDGE_BOOT_PACKAGES:-} ]]; then
    # studio-build's makepkg.conf compresses with xz unless a build overrides it.
    # Accept either archive. Signatures use the same suffix plus .sig.
    shopt -s nullglob
    boot_archives=("$SMARTROOM_EDGE_BOOT_PACKAGES"/*.pkg.tar.zst "$SMARTROOM_EDGE_BOOT_PACKAGES"/*.pkg.tar.xz)
    boot_sigs=("$SMARTROOM_EDGE_BOOT_PACKAGES"/*.pkg.tar.zst.sig "$SMARTROOM_EDGE_BOOT_PACKAGES"/*.pkg.tar.xz.sig)
    (( ${#boot_archives[@]} && ${#boot_sigs[@]} )) || { echo "SMARTROOM_EDGE_BOOT_PACKAGES has no packages" >&2; exit 1; }
    cp -a "${boot_archives[@]}" "${boot_sigs[@]}" "$out/repo/"
    found_aura=("${out}/repo"/aura-*.pkg.tar.zst "${out}/repo"/aura-*.pkg.tar.xz)
    found_kernel=("${out}/repo"/linux-aurora-*.pkg.tar.zst "${out}/repo"/linux-aurora-*.pkg.tar.xz)
    shopt -u nullglob
    (( ${#found_aura[@]} && ${#found_kernel[@]} )) ||
      { echo "SMARTROOM_EDGE_BOOT_PACKAGES has no aura and linux-aurora packages" >&2; exit 1; }
    # The edge Mesa that opens the 7.3 kernel's "aurora" GPU driver.
    if [[ -d $src/pkgs/smartroom/pkgbuilds/mesa-aurora ]]; then
      shopt -s nullglob
      found_mesa=("${out}/repo"/mesa-aurora-[0-9]*.pkg.tar.zst "${out}/repo"/mesa-aurora-[0-9]*.pkg.tar.xz)
      found_vulkan=("${out}/repo"/vulkan-aurora-[0-9]*.pkg.tar.zst "${out}/repo"/vulkan-aurora-[0-9]*.pkg.tar.xz)
      shopt -u nullglob
      (( ${#found_mesa[@]} && ${#found_vulkan[@]} )) ||
        { echo "SMARTROOM_EDGE_BOOT_PACKAGES has no mesa-aurora and vulkan-aurora packages" >&2; exit 1; }
    fi
  else
    packages+=(aura linux-aurora)
    [[ ! -d $src/pkgs/smartroom/pkgbuilds/mesa-aurora ]] || packages+=(mesa-aurora)
  fi
fi
for pkg in "${packages[@]}"; do
  cp -a "$src/pkgs/smartroom/pkgbuilds/$pkg" "$src/$pkg"
  (cd "$src/$pkg" && SMARTROOM_MAC_PKGS_COMMIT=$commit SMARTROOM_MAC_PKGS_DATE=$date \
    PKGDEST="$out/repo" makepkg --force --cleanbuild --syncdeps --noconfirm --sign --key "$key")
done
if grep -Eq '^[0-9a-f]{64} ' "$here/room/prebuilt.sha256"; then
  [[ -d ${SMARTROOM_ROOM_PACKAGES:-} ]] ||
    { echo "set SMARTROOM_ROOM_PACKAGES to the directory with the files room/prebuilt.sha256 pins" >&2; exit 1; }
  "$here/copy-prebuilt" "$here/room/prebuilt.sha256" "$SMARTROOM_ROOM_PACKAGES" "$out/repo" "$key"
fi
rm -f "$out/repo"/smartroom.db* "$out/repo"/smartroom.files*
repo-add -q "$out/repo/smartroom.db.tar.gz" "$out"/repo/*.pkg.tar.*[!g]
cp --remove-destination "$out/repo/smartroom.db.tar.gz" "$out/repo/smartroom.db"
gpg --armor --export "$key" >"$out/key.asc"
printf '%s\n' "$key" >"$out/key.fpr"
printf 'omarchy_mac_pkgs_commit=%s\n' "$commit" >"$out/SOURCE"
ls -l "$out/repo"
