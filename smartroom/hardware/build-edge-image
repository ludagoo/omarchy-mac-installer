#!/bin/bash
# SmartRoom edge image from pinned commits of the installer, packages and firmware repos, on studio-build
# (ARM builds happen only there). Steps: aura, linux-aurora and mesa-aurora (with vulkan-aurora) built
# into boot-pkgs; the SmartRoom repo (smartroom/build-packages); the image (smartroom/build-image);
# smartroom/desk-check on the result. Every commit is pinned at the start, so a branch moving during
# the run cannot mix. Needs on studio-build: docker, sudo -n, ~/build.lock, the package signing key
# (~/omarchy-fork/pkg-key.fpr), the recovery app, the omarchy-fork cache, and a firmware bundle.
# Usage: build-edge-image INSTALLER_SHA PKGS_SHA FIRMWARE_SHA
#   Work dir: $JOBDIR (default ~/jobs/edge-image); progress in $JOBDIR/phase, log in $JOBDIR/build.log.
#   The image and SHA256 end up in $JOBDIR/image/out and $JOBDIR/image/SHA256.
set -Eeuo pipefail
ISHA=${1:?installer sha} PSHA=${2:?pkgs sha} FW=${3:?firmware sha}
W=${JOBDIR:-$HOME/jobs/edge-image}
OLD=$HOME/edge-aura
mkdir -p "$W"
exec >>"$W/build.log" 2>&1
phase() { printf '%s %s\n' "$(date -Is)" "$*" | tee -a "$W/phase"; }
echo RUNNING >"$W/state"
trap 'rc=$?; phase "FAILED exit $rc (line $LINENO)"; echo FAILED >"$W/state"' ERR
exec 9>"$HOME/build.lock"
flock -n 9
phase "start edge build installer=$ISHA pkgs=$PSHA firmware=$FW"
sudo -n true
for tool in python3 python docker fdtget dtc bsdtar jq strings; do command -v "$tool" >/dev/null; done
docker info >/dev/null
KEY=$(tr -d '[:space:]' <"$HOME/omarchy-fork/pkg-key.fpr")
[[ $KEY =~ ^[0-9A-Fa-f]{40}$ ]]
printf 'x\n' | gpg --batch --local-user "$KEY" --detach-sign --output "$W/sign-test.sig" >/dev/null
rm -f "$W/sign-test.sig"
phase "preflight ok key ${KEY:0:8}"

for r in installer:omarchy-mac-installer pkgs:omarchy-mac-pkgs; do
  d=${r%%:*}; repo=${r##*:}
  [[ -d $W/$d ]] || git clone -q "https://github.com/ludagoo/$repo.git" "$W/$d"
  git -C "$W/$d" fetch -q origin
done
git -C "$W/installer" checkout -q -f "$ISHA"
git -C "$W/pkgs" checkout -q -f "$PSHA"
phase "installer $(git -C "$W/installer" rev-parse HEAD) pkgs $(git -C "$W/pkgs" rev-parse HEAD)"

recipe=$W/pkgs/smartroom/pkgbuilds
pin() { sed -n 's/^_commit=\([0-9a-f]\{40\}\)$/\1/p' "$recipe/$1/PKGBUILD"; }
AURA_COMMIT=$(pin aura)
KERNEL_COMMIT=$(pin linux-aurora)
MESA_COMMIT=$(pin mesa-aurora)
[[ -n $AURA_COMMIT && -n $KERNEL_COMMIT && -n $MESA_COMMIT ]]
phase "recipes: aura $AURA_COMMIT linux-aurora $KERNEL_COMMIT mesa-aurora $MESA_COMMIT"

R=$W/image
mkdir -p "$R"
RECOVERY=$HOME/omarchy-fork/release-3/recovery
phase "resolve edge inputs"
"$W/installer/image-builder/bin/mac-image-inputs" resolve "$R/inputs" \
  --channel-set --channel edge --recovery-app "$RECOVERY" --cache "$HOME/omarchy-fork/cache"
grep -E '^(omarchy_channel|omarchy_db_sha256|channel_set|recovery_app_manifest_sha256)=' "$R/inputs" | tee -a "$W/phase"

export OMARCHY_BUILD_JOBS=${JOBS:-6}
export MAKEFLAGS=-j${JOBS:-6}
BOOT=$W/boot-pkgs
mkdir -p "$BOOT"
export SRCDEST=$W/srcdest
mkdir -p "$SRCDEST"
# Reuse the git mirrors (not the packages) of the earlier builds.
for m in "$OLD/srcdest/"* "$HOME/edge-desktop/srcdest/"*; do
  [[ -e $m && ! -e $SRCDEST/${m##*/} ]] && cp -a "$m" "$SRCDEST/"
done
cat >"$W/makepkg.conf" <<EOC
source /etc/makepkg.conf
OPTIONS=(!strip docs !libtool !staticlibs emptydirs zipman purge !debug !lto)
MAKEFLAGS=-j${JOBS:-6}
PKGEXT='.pkg.tar.zst'
SRCEXT='.src.tar.zst'
EOC

build_one() {
  local name=$1 ver
  ver=$(cd "$recipe/$name" && makepkg --printsrcinfo | awk '$1 == "pkgver" { v = $3 } $1 == "pkgrel" { r = $3 } $1 == "epoch" { e = $3 } END { print (e ? e ":" : "") v "-" r }')
  if [[ -f $BOOT/$name-${ver//:/_}.ok ]]; then
    phase "skip $name $ver (already built)"
    return 0
  fi
  phase "makepkg $name $ver"
  local src=$W/src-$name
  rm -rf "$src"
  cp -a "$recipe/$name" "$src"
  (cd "$src" && PKGDEST="$BOOT" makepkg --config "$W/makepkg.conf" \
    --force --cleanbuild --syncdeps --noconfirm --sign --key "$KEY")
  : >"$BOOT/$name-${ver//:/_}.ok"
  phase "makepkg $name $ver done"
}
build_one aura
build_one linux-aurora
build_one mesa-aurora
ls -l "$BOOT" | tee -a "$W/phase"

phase "check boot packages"
shopt -s nullglob
auras=("$BOOT"/aura-[0-9]*.pkg.tar.zst)
kernels=("$BOOT"/linux-aurora-[0-9]*.pkg.tar.zst)
(( ${#auras[@]} == 1 && ${#kernels[@]} == 1 ))
for p in "$BOOT"/*.pkg.tar.zst; do gpg --batch --verify "$p.sig" "$p"; done
got=$(bsdtar -xOf "${kernels[0]}" usr/share/doc/linux-aurora/smartroom-kernel-commit)
[[ $got == "$KERNEL_COMMIT" ]] || { phase "kernel package commit $got, recipe $KERNEL_COMMIT"; false; }
got=$(bsdtar -xOf "${auras[0]}" usr/share/doc/aura/build-qualification.json | jq -r .source_commit)
[[ $got == "$AURA_COMMIT" ]] || { phase "aura package commit $got, recipe $AURA_COMMIT"; false; }
dt=$(mktemp -d -p "$W")
bsdtar -xf "${kernels[0]}" -C "$dt" --include '*/dtbs/t6021-j475c.dtb' --include '*/apple-ave.ko*'
dtb=$(find "$dt" -name t6021-j475c.dtb)
[[ $(fdtget -t s "$dtb" /soc/dma-controller@40d020000 status) == disabled ]]
[[ $(fdtget -t s "$dtb" /soc/dma-controller@507020000 status) == disabled ]]
hw=/soc/smc@2a2400000/hwmon
fdtget "$dtb" "$hw" apple,discover-temperatures >/dev/null
[[ $(fdtget -t s "$dtb" "$hw" apple,thermal-pressure-key) == mTPL ]]
if fdtget -l "$dtb" "$hw" | grep -q '^temperature-'; then phase "j475c tree lists its own temperature channels"; false; fi
ko=$(find "$dt" -name 'apple-ave.ko*')
strings -a "$ko" >"$dt/ave-strings"
for a in busy_ns active_sessions frames; do grep -qx "$a" "$dt/ave-strings"; done
rm -rf "$dt"
phase "boot packages carry aura $AURA_COMMIT, kernel $KERNEL_COMMIT; mesa recipe $MESA_COMMIT"

phase "smartroom repo"
PKGS=$W/smartroom-pkgs
rm -rf "$PKGS"
export SMARTROOM_PKG_KEY=$KEY
export SMARTROOM_EDGE_BOOT_PACKAGES=$BOOT
export SMARTROOM_ROOM_PACKAGES=$OLD/room-pkgs-r3
"$W/installer/smartroom/build-packages" "$PKGS" "$PSHA"
phase "repo $(cat "$PKGS/SOURCE")"
bsdtar -xOf "$PKGS/repo/smartroom.db" '*/desc' | awk '/^%NAME%$/{getline; n=$0} /^%VERSION%$/{getline; print n, $0}' | tee -a "$W/phase"
for p in "$PKGS"/repo/*.pkg.tar.*[!g]; do gpg --batch --verify "$p.sig" "$p" 2>/dev/null; done
phase "every package in the SmartRoom repo has a good signature"

out=$R/out
[[ ! -e $out ]] || mv "$out" "$R/out.old.$(date +%s)"
phase "build-image (firmware $FW)"
(
  cd "$W/installer"
  smartroom/build-image --inputs "$R/inputs" --recovery-app "$RECOVERY" \
    --cache "$HOME/omarchy-fork/cache" --packages "$PKGS" --firmware "$FW" \
    --firmware-repo "$HOME/omarchy-fork/srfw-af9323e.bundle" \
    --keys "$HOME/omarchy-fork/authorized_keys" "$out"
)
phase "image built"
ls -l "$out" | tee -a "$W/phase"

phase "desk-check"
sudo -n rm -rf "$R/dc"
dc=$W/desk-check-$(git -C "$W/installer" rev-parse --short HEAD).txt
set +e
sudo -n "$W/installer/smartroom/desk-check" "$out"/*.zip "$R/dc" | tee "$dc"
dcrc=${PIPESTATUS[0]}
set -e
phase "desk-check exit $dcrc ($dc)"
(( dcrc == 0 ))
grep -qx "kernel commit: $KERNEL_COMMIT" "$dc"
grep -qx "aura commit: $AURA_COMMIT" "$dc"
grep -q '^PASS room browser chromium-smartroom installed' "$dc"
sha=$(cd "$out" && sha256sum *.zip | tee "$R/SHA256")
phase "EDGE IMAGE READY"
printf '%s\n' "$sha"
echo DONE >"$W/state"
echo EDGE IMAGE READY
