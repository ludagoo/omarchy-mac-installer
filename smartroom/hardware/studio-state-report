#!/bin/bash
# Read-only state report of a Studio room after a boot: kernel, panic=10, units, network, Hyprland,
# the Room Controller (agent), monitors, power-on policy, watchdog. Run it on the Studio, as root.
#   UPS=<seconds of uptime, for the coredump window> studio-state-report
echo "== $(date -Is) boot $(cat /proc/sys/kernel/random/boot_id | cut -c1-8) uptime $(cut -d' ' -f1 /proc/uptime)s kernel $(uname -r)"
echo "cmdline: $(cat /proc/cmdline)"
echo "kernel.panic=$(cat /proc/sys/kernel/panic)"
echo "system: $(systemctl is-system-running)"
systemd-analyze 2>&1 | head -2
echo "failed units:"; systemctl --failed --no-legend --no-pager | sed 's/^/  /'
echo "end0: $(journalctl -b -u NetworkManager --no-pager | grep -E 'device \(end0\): state change: secondaries -> activated' | head -1 | cut -c1-30)"
echo "end0 link carrier: $(cat /sys/class/net/end0/carrier 2>&1)  $(ip -br a show end0 | tr -s ' ')"
echo "Hyprland: $(pgrep -a Hyprland | head -1 | cut -c1-80) started $(ps -o lstart= -p $(pgrep -o Hyprland) 2>/dev/null)"
echo "greetd: $(systemctl is-active greetd) NRestarts=$(systemctl show greetd -p NRestarts --value)"
echo "coredumps this boot: $(coredumpctl list --since "$(date -d @$(( $(date +%s) - ${UPS:-0} )) '+%F %T')" --no-legend 2>/dev/null | wc -l)"
echo "agent: $(systemctl is-active smartroom-agent)"
echo "agent register failures this boot: $(journalctl -b -u smartroom-agent --no-pager | grep -c 'room register failed')"
echo "agent established connections: $(ss -tnp 2>/dev/null | grep -c 'ESTAB.*python')"
journalctl -b -u smartroom-agent --no-pager | grep 'published display inventory' | tail -1 | cut -c1-160
echo "monitors (Hyprland):"; sudo -u smartroomcontroller env XDG_RUNTIME_DIR=/run/user/$(id -u smartroomcontroller) HYPRLAND_INSTANCE_SIGNATURE=$(ls -t /run/user/$(id -u smartroomcontroller)/hypr 2>/dev/null | head -1) hyprctl monitors 2>&1 | grep -E "^Monitor|^\s*[0-9]+x[0-9]+" | head -8
echo "DRM connectors: $(for c in /sys/class/drm/card*-*/status; do printf '%s=%s ' "$(basename $(dirname $c))" "$(cat $c)"; done)"
echo "ac-power: $(smartroomos-ac-power status 2>&1 | tail -1)"
journalctl -b -u smartroomos-ac-power --no-pager | tail -2 | cut -c1-200
echo "wdctl: $(wdctl -x 2>&1 | head -3 | tr '\n' ' ')"
echo "previous boot end:"; journalctl -b -1 --no-pager -n 6 2>/dev/null | cut -c1-160
