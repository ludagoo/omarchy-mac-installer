#!/bin/bash
# Reboot the test Studio into Linux ONCE (macOS stays the persistent default), and wait for SSH.
# Run from the Mini, holding the Studio lock. Follows the Studio safety rules: macOS stays the default,
# every Linux boot is one-shot, and a hold file stops it.
#   studio-oneshot-reboot [wait-seconds]          (default 600)
#   STUDIO_CRASH=1 studio-oneshot-reboot          crash the kernel instead of a clean reboot
#                                                 (sysrq c; panic=10 reboots it; needs panic=10 on the command line)
# Env: STUDIO_SSH (default studio-home-linux), STUDIO_MACOS_SSH (studio-home-macos),
#      STUDIO_LOCK (~/smartroom-aurora-pr/STUDIO-LOCK), STUDIO_HOLD (~/smartroom-aurora-kernel/HOLD-REBOOTS)
# Exit: 0 Linux answered; 2 macOS answered (the one-shot did not hold; bless --nextonly from macOS);
#       1 nothing answered; 3 hold or no lock; 4 bless or preflight failed.
set -u
SSH=${STUDIO_SSH:-studio-home-linux}; MACSSH=${STUDIO_MACOS_SSH:-studio-home-macos}
LOCK=${STUDIO_LOCK:-$HOME/smartroom-aurora-pr/STUDIO-LOCK}; HOLD=${STUDIO_HOLD:-$HOME/smartroom-aurora-kernel/HOLD-REBOOTS}
wait_s=${1:-600}
[[ -e $HOLD ]] && { echo "$HOLD exists: no reboot"; exit 3; }
[[ -f $LOCK ]] || { echo "take $LOCK first"; exit 3; }
ssh "$SSH" 'test -L /lib -a -L /bin -a -L /sbin || exit 9
  if [ "'"${STUDIO_CRASH:-0}"'" = 1 ]; then grep -q "panic=10" /proc/cmdline && [ "$(cat /proc/sys/kernel/panic)" = 10 ] || exit 8; fi
  aurora-bless --set-boot-macos --yes && aurora-bless --next --set-boot "SmartRoom Firmware" --yes && aurora-bless --get-boot && sync' ||
  { echo "preflight or bless failed"; exit 4; }
t0=$(date +%s); echo "$([[ ${STUDIO_CRASH:-0} == 1 ]] && echo crash || echo reboot) at $(date -Is)"
if [[ ${STUDIO_CRASH:-0} == 1 ]]; then
  ssh "$SSH" 'echo 1 > /proc/sys/kernel/sysrq; echo c > /proc/sysrq-trigger' 2>&1 | head -2
else
  ssh "$SSH" 'systemctl reboot' 2>&1 | head -2
fi
sleep "${STUDIO_SETTLE:-15}"
for ((i = 0; i < wait_s / 5; i++)); do
  if ssh -o ConnectTimeout=4 -o BatchMode=yes "$SSH" 'echo up' 2>/dev/null | grep -q up; then
    echo "Linux answered SSH after $(( $(date +%s) - t0 )) s"; exit 0
  fi
  if ssh -o ConnectTimeout=4 -o BatchMode=yes -o StrictHostKeyChecking=no "$MACSSH" 'echo macos-up' 2>/dev/null | grep -q macos-up; then
    echo "macOS answered SSH after $(( $(date +%s) - t0 )) s (the one-shot did not hold)"; exit 2
  fi
  sleep 5
done
echo "no SSH after $wait_s s"; exit 1
