# What the SmartRoom image installs in place of the runtime's package lists:
# ludagoo/smartroomcontrollerfirmware builder/packages-target.aarch64 minus
# everything the Omarchy bottom layer already installs (kernel, m1n1, U-Boot,
# Limine and its hooks, asahi-scripts, asahi-fwextract, cpio, aurora-bless,
# Mesa/Vulkan, the audio stack, speakerguardd, avd-fw, libva-v4l2_request-avd,
# wf-recorder, networkmanager, iwd, sudo, curl, jq, btrfs-progs) and plus the
# helper package omarchy-mac-boot depends on.
smartroom-omarchy-helpers # Omarchy runtime files omarchy-mac-boot calls (no desktop)
smartroom-boot-os        # switch between SmartRoom Firmware and macOS (aurora-bless)
smartroom-release        # update and roll back by trial boot (aura-try), the Room Controller's helper
cloudflared              # per-room Cloudflare SSH tunnel (firmware smartroom-tunnel.service; ALARM extra, as the Mini)
omarchy-keyring          # Omarchy package key; first boot populates it
snapper                  # Omarchy's snapper root config (bottom layer, install/config/snapper.sh)
speakersafetyd           # speakers stay muted without it
rtkit                    # pipewire realtime
hyprland                 # kiosk compositor (Omarchy's build)
aquamarine               # Omarchy's patched aquamarine
hyprland-guiutils        # hyprland dep
hyprtoolkit              # hyprland-guiutils dep
chromium-smartroom       # room browser, direct V4L2 decode and encode (room/prebuilt.sha256)
libva                    # VA-API for Chromium decode
ffmpeg                   # software encode for previews
greetd                   # passwordless autologin, no greeter UI
pipewire
pipewire-pulse
pipewire-alsa
wireplumber
alsa-utils
bluez
bluez-utils
ttf-liberation           # Chromium needs a metric-compatible font
zram-generator           # swap without a partition
openssh                  # key-only remote, on from the first boot
python                   # SmartRoom room program runtime
inetutils                # hostname (room program install)
usbmuxd                  # iPad USB mux (udev). Arch 1.1.1 does not switch Internet Sharing mode
libimobiledevice         # lockdown tools (idevicepair) for the one-time trust check
dnsmasq                  # DHCP and DNS for NetworkManager ipv4.method=shared
iptables                 # NAT for that shared profile; the image has no filter firewall
