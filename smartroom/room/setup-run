#!/bin/bash
# The SmartRoom room layer. build-mac-image --smartroom runs this as setup/run
# inside the image root (a chroot), after Omarchy's finalizer and before the
# initramfs, the Limine activation and the @factory seal. Beside it:
#   firmware/         ludagoo/smartroomcontrollerfirmware at the commit in
#                     firmware/COMMIT (branch omarchy-base)
#   authorized_keys   the admin public keys (never a secret; not committed)
#   overlay-exclude   overlay files the Omarchy base owns (never installed)
#   release-key.asc   the production public key smartroom-release trusts
#   release-key-dev.asc   optional dev public half (never a secret)
#   build-info        lines for /usr/share/smartroom/build-info
# It installs our overlay minus overlay-exclude (our first boot is in it), the
# DHCP client id, then runs our studio setup unchanged in image mode (user,
# keys, sshd, greetd, the room timezone, units). Packages are already installed.
set -euo pipefail
here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
fw=$here/firmware
[[ -d $fw/overlay && -x $fw/bin/smartroom-studio-setup && -f $here/authorized_keys && -f $here/smartroom-wired.nmconnection ]] ||
  { echo "setup: firmware/ or authorized_keys missing" >&2; exit 1; }

# overlay-exclude is read top to bottom and the last pattern that matches a
# path decides. A line starting with ! puts a path back (it is ours on the
# Studio too), like .gitignore.
excluded() {
  local pattern verdict=1
  while read -r pattern; do
    [[ -n $pattern && $pattern != \#* ]] || continue
    if [[ $pattern == '!'* ]]; then
      # shellcheck disable=SC2053
      [[ $1 == ${pattern:1} ]] && verdict=1
    else
      # shellcheck disable=SC2053
      [[ $1 == $pattern ]] && verdict=0
    fi
  done <"$here/overlay-exclude"
  return $verdict
}

# Our overlay without what the Omarchy base owns. The studio setup copies it
# (its own Mini-only filter still applies).
overlay=/var/tmp/smartroom-overlay
rm -rf "$overlay"
mkdir -p "$overlay"
while IFS= read -r -d '' rel; do
  rel=${rel#./}
  if excluded "$rel"; then
    echo "setup: left to Omarchy: $rel"
    continue
  fi
  mkdir -p "$overlay/$(dirname -- "$rel")"
  cp -a --no-preserve=ownership "$fw/overlay/$rel" "$overlay/$rel"
done < <(cd "$fw/overlay" && find . -mindepth 1 \( -type f -o -type l \) -print0)

# The flag our first boot and first-connect read: snapshots are Omarchy's.
install -d -m 0755 /etc/smartroom
: >/etc/smartroom/omarchy-base
# The Room Controller's update and rollback helper is smartroom-release (the Mini's
# snapshot tool is in overlay-exclude). Written before the studio setup, whose
# product contract requires this pin on an Omarchy-base image.
install -d -m 0755 /etc/systemd/system/smartroom-controller.service.d
printf '[Service]\nEnvironment=SMARTROOM_SNAPSHOT_HELPER=/usr/bin/smartroom-release\n' \
  >/etc/systemd/system/smartroom-controller.service.d/snapshot-helper.conf
# smartroom-release checks a release's manifest against this key (the SmartRoom
# package key, public). Without it a room can only stage an unsigned release.
# release-key.asc is the production half. release-key-dev.asc, when the build
# passed one, is the dev half and must be a different key.
if [[ -f $here/release-key.asc ]]; then
  # shellcheck source=/dev/null
  source "$fw/overlay/usr/local/lib/smartroom/release-lib.sh"
  declare -F smartroom_install_public_keyring >/dev/null ||
    { echo "setup: firmware release-lib has no smartroom_install_public_keyring" >&2; exit 1; }
  smartroom_install_public_keyring "$here/release-key.asc" /usr/share/smartroom/release-keyring.gpg
  if [[ -f $here/release-key-dev.asc ]]; then
    smartroom_install_public_keyring "$here/release-key-dev.asc" /usr/share/smartroom/release-keyring-dev.gpg \
      /usr/share/smartroom/release-keyring.gpg
  fi
fi
# Omarchy's first boot (keyring, deferred hardware setup, the boot rebuild)
# finishes before ours starts: both make the pacman keyring, and ours ends in
# a reboot.
install -d -m 0755 /etc/systemd/system/smartroom-firstboot.service.d
printf '[Unit]\nAfter=omarchy-mac-first-boot.service omarchy-provision-hardware.service\n' \
  >/etc/systemd/system/smartroom-firstboot.service.d/10-after-omarchy-first-boot.conf
install -D -m 0644 "$fw/builder/image/rootfs/etc/NetworkManager/conf.d/smartroom-dhcp-client-id.conf" \
  /etc/NetworkManager/conf.d/smartroom-dhcp-client-id.conf
# The Studio AQC113 drops replies unless its port accepts all MAC addresses
# (omacom/omarchy-mac-pkgs#137). NetworkManager only reads 0600 root keyfiles.
install -D -m 0600 "$here/smartroom-wired.nmconnection" \
  /etc/NetworkManager/system-connections/smartroom-wired.nmconnection

# The studio setup, unchanged, in image mode. The image keeps Omarchy's stable
# pacman template; the setup installs no packages.
SMARTROOM_IMAGE_BUILD=1 \
  SMARTROOM_OVERLAY="$overlay" \
  SMARTROOM_LIB="$overlay/usr/local/lib/smartroom/install-lib.sh" \
  SMARTROOM_AUTHORIZED_KEYS="$here/authorized_keys" \
  "$fw/bin/smartroom-studio-setup"
rm -rf "$overlay"

# As on a stock Omarchy Mac (its install/config/enable-services.sh, which a
# room does not run): nothing at boot waits for the network to come up.
systemctl mask NetworkManager-wait-online.service

install -D -m 0644 "$here/build-info" /usr/share/smartroom/build-info
echo "setup: SmartRoom room layer installed"
