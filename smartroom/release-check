#!/bin/bash
# Check a SmartRoom release directory before it is published:
#   smartroom/release-check DIR FINGERPRINT KEY.ASC CHANNEL [defer]
# DIR (OUT/release/VERSION of smartroom/build-image) must hold the database,
# PACKAGES and RELEASE with good signatures by FINGERPRINT (KEY.ASC its public
# key), every archive PACKAGES names with its sha256 and a signature, and a
# database that lists exactly PACKAGES. CHANNEL is dev or production. RELEASE
# must record that channel. Production must be the production fingerprint;
# dev must not be. defer skips only that fingerprint rule: the build signs
# with its own key, and a later job signs again with the channel key.
set -euo pipefail
here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
dir=${1:?Usage: smartroom/release-check DIR FINGERPRINT KEY.ASC CHANNEL}
key=${2:?Usage: smartroom/release-check DIR FINGERPRINT KEY.ASC CHANNEL}
asc=${3:?Usage: smartroom/release-check DIR FINGERPRINT KEY.ASC CHANNEL}
channel=${4:?Usage: smartroom/release-check DIR FINGERPRINT KEY.ASC CHANNEL [defer]}
defer=${5-}
fail() { echo "release-check: $*" >&2; exit 1; }
# Later checks cd into DIR. A relative DIR would then miss its own files.
[[ -d $dir ]] || fail "no release directory: $dir"
dir=$(cd -- "$dir" && pwd)
# The production release key. Dev signatures must be some other key.
# Override with SMARTROOM_PRODUCTION_KEY_FPR for other deployments.
production_fpr=${SMARTROOM_PRODUCTION_KEY_FPR:-26436A50BDD17118770DE9185FDA1532DC448891}
[[ $channel == dev || $channel == production ]] || fail "channel must be dev or production: $channel"
[[ -z $defer || $defer == defer ]] || fail "the fifth argument is defer or nothing"
if [[ $defer != defer ]]; then
  if [[ $channel == production ]]; then
    [[ $key == "$production_fpr" ]] || fail "production must be signed by $production_fpr, not $key"
  else
    [[ $key != "$production_fpr" ]] || fail "dev must not be signed by the production key"
  fi
fi
asc_fpr=$(gpg --batch --with-colons --show-keys "$asc" 2>/dev/null | awk -F: '$1 == "fpr" { print $10; exit }')
[[ $asc_fpr == "$key" ]] || fail "$asc is ${asc_fpr:-not a public key}, not $key"

check=$(mktemp -d)
trap 'rm -rf "$check"' EXIT
gpg --homedir "$check" --batch --quiet --import "$asc" 2>/dev/null || fail "$asc is no public key"
for name in smartroom-release.db PACKAGES RELEASE; do
  [[ -f $dir/$name && -f $dir/$name.sig ]] || fail "$dir/$name or its signature is missing"
  gpg --homedir "$check" --batch --status-fd 1 --verify "$dir/$name.sig" "$dir/$name" 2>/dev/null |
    awk -v key="$key" '$2 == "VALIDSIG" && ($3 == key || $NF == key) { ok = 1 } END { exit !ok }' ||
    fail "$name is not signed by $key"
done
while IFS='|' read -r name version _ file sha; do
  [[ -f $dir/$file && -s $dir/$file.sig ]] || fail "$name $version: $file or its signature is missing"
  [[ $(sha256sum "$dir/$file" | cut -d' ' -f1) == "$sha" ]] || fail "$name $version: $file is not the recorded archive"
done <"$dir/PACKAGES"
python3 "$here/../image-builder/builder/release_repo.py" check-db --records "$dir/PACKAGES" "$dir/smartroom-release.db" ||
  fail "the database is not PACKAGES"
grep -q '^release=' "$dir/RELEASE" && grep -q '^package_set_sha256=[0-9a-f]\{64\}$' "$dir/RELEASE" ||
  fail "RELEASE names no release or package set"
grep -qx "channel=$channel" "$dir/RELEASE" || fail "RELEASE channel is not $channel"
[[ $(sed -n 's/^repository_sha256=//p' "$dir/RELEASE") == "$(sha256sum "$dir/smartroom-release.db" | cut -d' ' -f1)" ]] ||
  fail "RELEASE names another database"
extra=$(cd "$dir" && find . -maxdepth 1 -type f ! -name '*.sig' ! -name smartroom-release.db ! -name PACKAGES ! -name RELEASE -printf '%f\n' |
  LC_ALL=C sort | comm -23 - <(cut -d'|' -f4 "$dir/PACKAGES" | LC_ALL=C sort))
[[ -z $extra ]] || fail "files PACKAGES does not name: $(paste -sd' ' <<<"$extra")"
echo "release $(sed -n 's/^release=//p' "$dir/RELEASE"): $(wc -l <"$dir/PACKAGES") packages, signed by $key"
