  done_list="$done_list ${M_KIND[j]} ${M_UUID[j]} removed;"
  left_list=${left_list#* ${M_KIND[j]} ${M_UUID[j]};}
  j=$((j + 1))
done
grow_macos
startup_check
[ "$startup" = macos ] || echo "warning: the startup disk now reads as $startup_text; set macOS in System Settings, Startup Disk"
say "done: \"$stub_name\" removed; macOS ${P_ID[1]} is ${P_SIZE[1]} bytes; startup disk: $startup_text"
echo "Log: $log"
