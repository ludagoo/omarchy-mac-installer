#!/bin/bash
# smartroom-boot-os (macOS side): choose what this Apple Silicon room Mac
# starts up from, from macOS. The Linux side is the package smartroom-boot-os
# (omarchy-mac-pkgs), same verbs.
#
#   sudo smartroom-boot-os firmware [--once] [--reboot] [--owner USER | --credential-file FILE]
#   sudo smartroom-boot-os macos    [--once] [--reboot] [--owner USER | --credential-file FILE]
#   sudo smartroom-boot-os status
#
# On Apple Silicon only a volume owner may change the startup disk: macOS's
# bless needs an owner's name and password (--user/--stdinpass) even as root,
# and nothing else can (no MDM command, no Jamf action; the boot-volume NVRAM
# variables are not writable from macOS). So switching needs a credential:
#   --owner USER            the password is the first line of standard input
#                           (SSH, or a Jamf script: ... --owner U <<<"$4");
#   --credential-file FILE  a root-owned 0600 file, line 1 the owner's short
#                           name, line 2 the password (for a LaunchDaemon);
# The password goes only to bless's standard input, never to argv or a log.
# smartroom/docs/install-zoom-room.md weighs these (and the option of
# keeping SmartRoom Firmware the default, which needs no credential at all).
#
# --once sets the next start only (bless --nextonly); otherwise the choice
# becomes the default. --reboot restarts after a verified change. The
# firmware volume is the APFS System volume named "SmartRoom Firmware" (or
# the older "SmartRoomOS"); macOS is the running system.
# Uses only macOS's own tools (diskutil, plutil, bless, nvram, shutdown):
# never python3, git, clang or xcrun, which open the Command Line Tools
# dialog on a room's screen.
set -eu
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export LC_ALL=C
die() { echo "smartroom-boot-os: $*" >&2; exit 1; }
usage() { sed -n 's/^#   sudo /  /p' "$0" >&2; exit 64; }

target="" once=0 reboot=0 owner="" credfile=""
while [ $# -gt 0 ]; do
  case $1 in
    firmware|macos|status) [ -z "$target" ] || usage; target=$1 ;;
    --once) once=1 ;;
    --reboot) reboot=1 ;;
    --owner) [ $# -ge 2 ] || usage; owner=$2; shift ;;
    --credential-file) [ $# -ge 2 ] || usage; credfile=$2; shift ;;
    *) usage ;;
  esac
  shift
done
[ -n "$target" ] || usage
[ "$(uname -s)" = Darwin ] || die "this runs on macOS (on SmartRoom Firmware use the smartroom-boot-os package)"
[ "$(id -u)" = 0 ] || die "run with sudo"

tmp=$(mktemp -d /tmp/smartroom-boot-os.XXXXXX)
mounted_esp=""
cleanup() {
  if [ -n "$mounted_esp" ]; then diskutil unmount "$mounted_esp" >/dev/null 2>&1 || true; fi
  rm -rf "$tmp"
}
trap cleanup EXIT
x() { plutil -extract "$2" raw -o - "$1" 2>/dev/null; }      # FILE KEYPATH
has() { plutil -extract "$2" xml1 -o /dev/null "$1" 2>/dev/null; }
up() { printf '%s' "$1" | tr '[:lower:]' '[:upper:]'; }

intel_main() {
  local APPLE_GUID="7c436110-ab2a-4bbb-a880-fe41995c9f82"
  diskutil info -plist / >"$tmp/root" 2>/dev/null || die "diskutil info / failed"
  local store mac_ref disk mac_store_uuid
  store=$(x "$tmp/root" APFSPhysicalStores.0.APFSPhysicalStore) || die "cannot read macOS physical store"
  mac_ref=$(x "$tmp/root" APFSContainerReference) || die "cannot read macOS container"
  diskutil info -plist "$store" >"$tmp/store" 2>/dev/null || die "diskutil info $store failed"
  disk=$(x "$tmp/store" ParentWholeDisk) || die "cannot read internal disk"
  mac_store_uuid=$(up "$(x "$tmp/store" DiskUUID)")

  diskutil list -plist "$disk" >"$tmp/list" 2>/dev/null || die "diskutil list $disk failed"
  local k="" i=0
  while has "$tmp/list" "AllDisksAndPartitions.$i"; do
    if [ "$(x "$tmp/list" "AllDisksAndPartitions.$i.DeviceIdentifier")" = "$disk" ]; then
      k=$i; break
    fi
    i=$((i + 1))
  done
  [ -n "$k" ] || die "$disk missing from diskutil list"

  # Locate SmartRoom's own ESP (at offset after macOS APFS; never disk0s1 Apple EFI).
  local mac_off fw_esp="" fw_uuid="" pid ptype puuid poff mp was_mounted
  diskutil info -plist "$store" >"$tmp/macp" 2>/dev/null || die "diskutil info $store failed"
  mac_off=$(x "$tmp/macp" PartitionMapPartitionOffset)
  i=0
  while has "$tmp/list" "AllDisksAndPartitions.$k.Partitions.$i"; do
    pid=$(x "$tmp/list" "AllDisksAndPartitions.$k.Partitions.$i.DeviceIdentifier")
    diskutil info -plist "$pid" >"$tmp/pi" 2>/dev/null || { i=$((i + 1)); continue; }
    ptype=$(x "$tmp/pi" Content || true)
    poff=$(x "$tmp/pi" PartitionMapPartitionOffset || echo 0)
    if [ "$ptype" = EFI ] && [ "$poff" -gt "$mac_off" ]; then
      puuid=$(up "$(x "$tmp/pi" DiskUUID || true)")
      mp=$(x "$tmp/pi" MountPoint || true)
      was_mounted=1
      if [ -z "$mp" ]; then
        was_mounted=0
        mp="$tmp/esp-$pid"
        mkdir -p "$mp"
        if ! diskutil mount readOnly nobrowse -mountPoint "$mp" "$pid" >/dev/null 2>&1; then
          i=$((i + 1)); continue
        fi
        mounted_esp=$pid
      fi
      if { [ -s "$mp/EFI/BOOT/BOOTX64.EFI" ] || [ -s "$mp/EFI/limine/limine_x64.efi" ]; } &&
         { [ -s "$mp/limine.conf" ] || [ -d "$mp/smartroomos" ] || [ -s "$mp/EFI/Linux/smartroomos_linux-t2.efi" ]; }; then
        [ -z "$fw_esp" ] || die "more than one SmartRoom Firmware ESP ($fw_esp, $pid)"
        fw_esp=$pid
        fw_uuid=$puuid
      fi
      if [ "$was_mounted" -eq 0 ]; then
        diskutil unmount "$pid" >/dev/null 2>&1 || true
        mounted_esp=""
      fi
    fi
    i=$((i + 1))
  done

  intel_classify_boot() {
    local dev_line=$1 id suuid parent
    case $dev_line in
      "") echo none; return 0 ;;
      /dev/disk*)
        id=${dev_line#/dev/}
        diskutil info -plist "$id" >"$tmp/bi" 2>/dev/null || { echo "other ($dev_line)"; return 0; }
        if has "$tmp/bi" APFSPhysicalStores.0; then
          local st
          st=$(x "$tmp/bi" APFSPhysicalStores.0.APFSPhysicalStore || true)
          diskutil info -plist "$st" >"$tmp/bs" 2>/dev/null || true
          suuid=$(up "$(x "$tmp/bs" DiskUUID || true)")
          parent=$(x "$tmp/bs" ParentWholeDisk || true)
          if [ "$suuid" = "$mac_store_uuid" ] && [ "$parent" = "$disk" ]; then
            echo macOS; return 0
          fi
        fi
        if [ -n "$fw_esp" ] && [ "$id" = "$fw_esp" ]; then
          echo "SmartRoom Firmware"; return 0
        fi
        if [ -n "$fw_uuid" ] && [ "$(up "$(x "$tmp/bi" DiskUUID || true)")" = "$fw_uuid" ]; then
          echo "SmartRoom Firmware"; return 0
        fi
        echo "other ($id)"; return 0 ;;
    esac
    case $(up "$dev_line") in
      *CORESERVICES*BOOT.EFI*) echo macOS ;;
      *BOOTX64.EFI*|*LIMINE_X64.EFI*) echo "SmartRoom Firmware" ;;
      *)
        if [ -n "$fw_uuid" ] && printf '%s' "$(up "$dev_line")" | grep -q "$fw_uuid"; then
          echo "SmartRoom Firmware"
        elif printf '%s' "$(up "$dev_line")" | grep -q "$mac_store_uuid"; then
          echo macOS
        else
          echo "other ($dev_line)"
        fi ;;
    esac
  }

  intel_default_label() {
    local b nv
    b=$(bless --getBoot 2>/dev/null | head -n 1 || true)
    if [ -n "$b" ]; then
      intel_classify_boot "$b"
      return 0
    fi
    nv=$(nvram "${APPLE_GUID}:efi-boot-device" 2>/dev/null | tr '\n' ' ' || true)
    nv=$(printf '%s' "$nv" | sed 's/^[^	]*	//')
    intel_classify_boot "$nv"
  }
  intel_next_label() {
    local nv
    nv=$(nvram "${APPLE_GUID}:efi-boot-next" 2>/dev/null | tr '\n' ' ' || true)
    nv=$(printf '%s' "$nv" | sed 's/^[^	]*	//')
    intel_classify_boot "$nv"
  }

  if [ "$target" = status ]; then
    echo "default: $(intel_default_label)"
    echo "next:    $(intel_next_label)"
    echo "firmware partition: ${fw_esp:-none}"
    exit 0
  fi

  local sip_out sip_ok=0
  sip_out=$(csrutil status 2>/dev/null || true)
  case $sip_out in
    *"System Integrity Protection status: disabled"*|*"NVRAM Protections: disabled"*) sip_ok=1 ;;
  esac
  [ "$sip_ok" -eq 1 ] ||
    die "SIP protects NVRAM ($sip_out); boot Recovery (Cmd+R) -> csrutil disable"

  local want_label next_arg=""
  if [ "$once" = 1 ]; then next_arg="--nextonly"; fi

  if [ "$target" = firmware ]; then
    [ -n "$fw_esp" ] || die "no SmartRoom Firmware ESP partition found on $disk"
    diskutil info -plist "$fw_esp" >"$tmp/fwi" 2>/dev/null || die "diskutil info $fw_esp failed"
    mp=$(x "$tmp/fwi" MountPoint || true)
    was_mounted=1
    if [ -z "$mp" ]; then
      was_mounted=0
      diskutil mount "$fw_esp" >/dev/null || die "could not mount $fw_esp"
      mounted_esp=$fw_esp
      diskutil info -plist "$fw_esp" >"$tmp/fwi" 2>/dev/null || die "diskutil info $fw_esp failed"
      mp=$(x "$tmp/fwi" MountPoint || true)
    fi
    [ -n "$mp" ] && [ -d "$mp" ] || die "SmartRoom ESP $fw_esp has no mount point"
    local efi_rel=""
    if [ -s "$mp/EFI/BOOT/BOOTX64.EFI" ]; then
      efi_rel="EFI/BOOT/BOOTX64.EFI"
    elif [ -s "$mp/EFI/limine/limine_x64.efi" ]; then
      efi_rel="EFI/limine/limine_x64.efi"
    else
      die "neither EFI/BOOT/BOOTX64.EFI nor EFI/limine/limine_x64.efi exists on $fw_esp"
    fi
    bless --mount "$mp" --setBoot $next_arg --file "$mp/$efi_rel" --shortform >"$tmp/bless.out" 2>&1 ||
      die "bless failed ($(tail -n 1 "$tmp/bless.out"))"
    if [ "$was_mounted" -eq 0 ]; then
      diskutil unmount "$fw_esp" >/dev/null 2>&1 || true
      mounted_esp=""
    fi
    want_label="SmartRoom Firmware"
  else
    bless --mount / --setBoot $next_arg >"$tmp/bless.out" 2>&1 ||
      die "bless --mount / failed ($(tail -n 1 "$tmp/bless.out"))"
    want_label="macOS"
  fi

  if [ "$once" = 0 ]; then
    nvram -d "${APPLE_GUID}:efi-boot-next" >/dev/null 2>&1 || true
    nvram -d "${APPLE_GUID}:efi-boot-next-data" >/dev/null 2>&1 || true
    got=$(intel_default_label)
    where=default
  else
    got=$(intel_next_label)
    where="next start"
  fi
  [ "$got" = "$want_label" ] || die "asked for $want_label as the $where, but the Mac reports $got"
  echo "$where: $want_label"
  [ "$reboot" = 0 ] || shutdown -r now
}

if [ "$(uname -m)" = x86_64 ]; then
  intel_main
  exit 0
fi

# The firmware's System volume: exactly one APFS System volume with our name.
diskutil apfs list -plist >"$tmp/apfs" || die "diskutil apfs list failed"
fw_volume="" fw_name="" c=0
while has "$tmp/apfs" "Containers.$c"; do
  v=0
  while has "$tmp/apfs" "Containers.$c.Volumes.$v"; do
    name=$(x "$tmp/apfs" "Containers.$c.Volumes.$v.Name" || true)
    role=$(x "$tmp/apfs" "Containers.$c.Volumes.$v.Roles.0" || true)
    if [ "$role" = System ] && { [ "$name" = "SmartRoom Firmware" ] || [ "$name" = SmartRoomOS ]; }; then
      [ -z "$fw_volume" ] || die "more than one SmartRoom Firmware volume ($fw_volume, $(x "$tmp/apfs" "Containers.$c.Volumes.$v.DeviceIdentifier"))"
      fw_volume=$(x "$tmp/apfs" "Containers.$c.Volumes.$v.DeviceIdentifier")
      fw_name=$name
    fi
    v=$((v + 1))
  done
  c=$((c + 1))
done
group_of() { diskutil info -plist "$1" >"$tmp/info" 2>/dev/null && x "$tmp/info" APFSVolumeGroupID; }
macos_group=$(group_of /) || die "cannot read the running macOS's volume group"
fw_group=""
[ -z "$fw_volume" ] || fw_group=$(group_of "$fw_volume") || die "cannot read $fw_volume's volume group"

# What starts next: bless --getBoot (the default) and alt-boot-volume (next only),
# whose value ends in the target's volume group.
default_group() { d=$(bless --getBoot 2>/dev/null) || return 0; group_of "${d#/dev/}" || true; }
next_group() { nvram alt-boot-volume 2>/dev/null | awk -F: '{ print $NF }' | tr -d '[:space:]' || true; }
label() {
  case $(printf '%s' "$1" | tr '[:lower:]' '[:upper:]') in
    "") echo "none" ;;
    "$(printf '%s' "$macos_group" | tr '[:lower:]' '[:upper:]')") echo macOS ;;
    "$(printf '%s' "$fw_group" | tr '[:lower:]' '[:upper:]')") echo "$fw_name" ;;
    *) echo "other ($1)" ;;
  esac
}
if [ "$target" = status ]; then
  echo "default: $(label "$(default_group)")"
  echo "next:    $(label "$(next_group)")"
  echo "firmware volume: ${fw_volume:-none} ${fw_name:+($fw_name)}"
  exit 0
fi

# As the engine blesses the stub (--device its System volume) and Omarchy's
# Remove blesses macOS (--mount /).
if [ "$target" = firmware ]; then
  [ -n "$fw_volume" ] || die "no SmartRoom Firmware volume on this Mac"
  args="--setBoot --device /dev/$fw_volume" want=$fw_group what=$fw_name
else
  args="--mount / --setBoot" want=$macos_group what=macOS
fi

# The owner credential.
if [ -n "$credfile" ]; then
  [ -z "$owner" ] || die "--owner or --credential-file, not both"
  [ -f "$credfile" ] && [ ! -L "$credfile" ] || die "no credential file $credfile"
  perms=$(stat -f '%u %Lp' "$credfile")
  [ "$perms" = "0 600" ] || [ "$perms" = "0 400" ] || die "$credfile must be root's and 0600 (it is: $perms)"
  owner=$(sed -n 1p "$credfile")
  password=$(sed -n 2p "$credfile")
else
  [ -n "$owner" ] || die "changing the startup disk needs an owner: --owner USER (password on stdin) or --credential-file FILE"
  IFS= read -r password || [ -n "${password-}" ] || die "no password on standard input"
fi
case $owner in ''|*[!A-Za-z0-9._-]*) die "the owner is not a macOS short user name" ;; esac
[ -n "$password" ] || die "empty password"

[ "$once" = 0 ] || args="$args --nextonly"
# shellcheck disable=SC2086
printf '%s\n' "$password" | bless $args --user "$owner" --stdinpass >"$tmp/bless.out" 2>&1 ||
  die "bless refused ($(tail -n 1 "$tmp/bless.out")). Is $owner a volume owner (secure token) and the password right?"
password=""

up() { printf '%s' "$1" | tr '[:lower:]' '[:upper:]'; }
if [ "$once" = 1 ]; then
  got=$(next_group) where="next start"
else
  got=$(default_group) where=default
fi
[ "$(up "$got")" = "$(up "$want")" ] || die "asked for $what as the $where, but the Mac reports $(label "$got")"
echo "$where: $what"
[ "$reboot" = 0 ] || shutdown -r now
