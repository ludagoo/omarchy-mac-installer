#!/bin/bash
# Desk-check a built image (stock or SmartRoom) on an aarch64 Linux host, as root:
#   smartroom/desk-check ZIP WORKDIR
# Unpacks the payload into WORKDIR, mounts root.img (@), boot.img and the ESP
# tree read-only, and runs the image's own omarchy-apple-silicon-boot-check
# (omarchy-mac-boot) in it, full and --boot-chain, plus the headless facts a
# room needs. Prints PASS/FAIL lines; exits non-zero on any FAIL.
set -uo pipefail
zip=${1:?Usage: smartroom/desk-check ZIP WORKDIR}
work=${2:?Usage: smartroom/desk-check ZIP WORKDIR}
(( EUID == 0 )) || { echo "run as root" >&2; exit 1; }
mkdir -p "$work/x" "$work/ro" "$work/mnt"
m=$work/mnt
ro=$work/ro
bootchk=$work/bootchk
cleanup() {
  umount -R "$bootchk/m" 2>/dev/null || true
  umount -R "$m" 2>/dev/null || true
  umount "$ro" 2>/dev/null || true
}
trap cleanup EXIT
[[ -f $work/x/root.img ]] || bsdtar -xf "$zip" -C "$work/x" root.img boot.img esp || exit 1
mount -o ro,loop,subvol=@ "$work/x/root.img" "$ro" || exit 1
mount --bind "$ro" "$m" || exit 1
mount -o ro,loop "$work/x/boot.img" "$m/boot" || exit 1
mount --bind -o ro "$work/x/esp" "$m/boot/efi" || exit 1
for d in proc sys dev run tmp; do
  case $d in
    proc) mount -t proc proc "$m/proc" ;;
    sys) mount -t sysfs sys "$m/sys" ;;
    dev) mount --rbind /dev "$m/dev" ;;
    *) mount -t tmpfs "$d" "$m/$d" ;;
  esac
done
fails=0
pass() { echo "PASS $*"; }
failed() { echo "FAIL $*"; fails=$((fails + 1)); }
check() { local what=$1; shift; if "$@" >/dev/null 2>&1; then pass "$what"; else failed "$what"; fi; }
kver=$(ls "$m/usr/lib/modules" | grep -- '-ARCH$' | head -n 1)
echo "kernel $kver"
bootchk_root=$m
if [[ ! -d $m/etc/pacman.d/gnupg ]]; then
  # Sealed WS2 release images drop /etc/pacman.d/gnupg (first boot builds it)
  # while keeping /var/lib/pacman/sync/smartroom-release.db.sig with
  # DatabaseRequired. Run the boot check against an ephemeral overlayfs root
  # whose keyring is populated strictly from the image's own keyrings.
  rm -rf "$bootchk"
  mkdir -p "$bootchk/up" "$bootchk/work" "$bootchk/m"
  mount -t overlay overlay -o "lowerdir=$ro,upperdir=$bootchk/up,workdir=$bootchk/work" "$bootchk/m" || exit 1
  mount --bind -o ro "$m/boot" "$bootchk/m/boot" || exit 1
  mount --bind -o ro "$m/boot/efi" "$bootchk/m/boot/efi" || exit 1
  for d in proc sys dev run tmp; do
    case $d in
      proc) mount -t proc proc "$bootchk/m/proc" ;;
      sys) mount -t sysfs sys "$bootchk/m/sys" ;;
      dev) mount --rbind /dev "$bootchk/m/dev" ;;
      *) mount -t tmpfs "$d" "$bootchk/m/$d" ;;
    esac
  done
  keyrings=(archlinuxarm asahi-alarm)
  [[ ! -f $bootchk/m/usr/share/pacman/keyrings/omarchy.gpg ]] || keyrings+=(omarchy)
  [[ ! -f $bootchk/m/usr/share/pacman/keyrings/smartroom.gpg ]] || keyrings+=(smartroom)
  chroot "$bootchk/m" pacman-key --init >/dev/null 2>&1 \
    && chroot "$bootchk/m" pacman-key --populate "${keyrings[@]}" >/dev/null 2>&1 \
    || failed "populate ephemeral pacman keyring from image keyrings"
  chroot "$bootchk/m" gpgconf --homedir /etc/pacman.d/gnupg --kill all >/dev/null 2>&1 || true
  bootchk_root=$bootchk/m
fi
for mode in "" --boot-chain; do
  if out=$(chroot "$bootchk_root" env -i PATH=/usr/bin:/usr/sbin OMARCHY_BOOT_CHECK_UNAME="$kver" \
      omarchy-apple-silicon-boot-check $mode linux-aurora 2>&1); then
    pass "omarchy-apple-silicon-boot-check ${mode:-(full)}: ${out##*$'\n'}"
  else
    failed "omarchy-apple-silicon-boot-check ${mode:-(full)}: $out"
  fi
done
if [[ $bootchk_root == "$bootchk/m" ]]; then
  chroot "$bootchk/m" gpgconf --homedir /etc/pacman.d/gnupg --kill all >/dev/null 2>&1 || true
  umount -R "$bootchk/m" 2>/dev/null || true
fi
wants=$m/etc/systemd/system/multi-user.target.wants
check "NetworkManager enabled (wired DHCP at boot)" test -L "$wants/NetworkManager.service"
check "NetworkManager-wait-online masked (nothing waits on the network)" test "$(readlink "$m/etc/systemd/system/NetworkManager-wait-online.service")" = /dev/null
check "first boot armed" test -f "$m/var/lib/omarchy/mac-first-boot/pending"
check "Limine on the U-Boot slot" cmp -s "$m/usr/share/limine/BOOTAA64.EFI" "$m/boot/efi/EFI/BOOT/BOOTAA64.EFI"
check "m1n1 stage 2 on the ESP" test -s "$m/boot/efi/m1n1/boot.bin"
check "j475c device tree in the kernel package" test -s "$m/boot/dtbs/apple/t6021-j475c.dtb" -o -n "$(find "$m/usr/lib/modules/$kver" "$m/boot" -name 't6021-j475c.dtb' 2>/dev/null | head -n 1)"
check "Aquantia 10GbE driver (atlantic) shipped" test -n "$(find "$m/usr/lib/modules/$kver" -name 'atlantic.ko*' | head -n 1)"
cmdline=$(sed -n 's/^ *cmdline: //p' "$m/boot/efi/limine.conf" | head -n 1)
echo "Limine cmdline: $cmdline"
echo "Limine entries: $(grep -E '^/' "$m/boot/efi/limine.conf" | paste -sd' ' -)"
echo "Limine timeout: $(sed -n 's/^timeout: //p' "$m/boot/efi/limine.conf")"
# The programs the room runs find their shared libraries. A prebuilt package (the room
# browser) names the sonames it was built against; the channel can move past them
# (2026-11-24: chromium-smartroom wanted libsimdutf.so.36, the channel had .so.37).
unresolved=$(chroot "$m" env -i PATH=/usr/bin /usr/bin/bash -c '
  for f in /usr/lib/chromium/* /usr/bin/chromium /usr/bin/Hyprland /usr/bin/hyprctl /usr/bin/greetd \
           /usr/bin/wf-recorder /usr/bin/ffmpeg /usr/bin/cloudflared /usr/bin/python3 /usr/bin/pipewire \
           /usr/bin/wireplumber /usr/bin/sshd /usr/bin/NetworkManager /usr/bin/sudo /usr/bin/systemctl; do
    [[ -f $f && ! -L $f ]] || continue
    [[ $f != /usr/lib/chromium/lib*_shim.so ]] || continue   # Qt/GTK UI shims: loaded only if that toolkit is there
    ldd "$f" 2>/dev/null | sed -n "s|^[[:space:]]*\([^[:space:]]*\) => not found|$f: \1|p"
  done' 2>&1)
if [[ -z $unresolved ]]; then
  pass "the room browser and the programs the room runs find their shared libraries"
else
  failed "programs whose shared libraries are missing:"
  while IFS= read -r line; do printf '  %s\n' "$line"; done <<<"$unresolved" | head -n 40
fi
# The root invariant: the image's own smartroom-release check-root, the one rule
# that build-release, the room's trial and its integrity check also run (owners,
# /, /etc, /usr, sudoers, visudo -c). Its exceptions are in that code, with reasons.
if inv=$(chroot "$m" env -i PATH=/usr/bin:/usr/sbin python3 -I /usr/bin/smartroom-release check-root / 2>&1); then
  pass "root invariant: ${inv%%$'\n'*}"
else
  failed "root invariant (smartroom-release check-root):"
  while IFS= read -r line; do printf '  %s\n' "$line"; done <<<"$inv" | head -n 40
fi
if [[ -e $m/etc/omarchy-mac-boot/headless ]]; then
  echo "== SmartRoom image"
  # This branch is the edge image. The enrolled first stage is the payload's
  # esp/aurora/stage1.bin (the Engine fills it into the stub). The ESP's
  # m1n1/boot.bin is aura's second stage. m1n1's raw image has the config
  # magic too, so the marker string is the check. The copy at
  # aurora/stage1.bin on the ESP is not what 1TR enrolls.
  aura_check=$(dirname -- "${BASH_SOURCE[0]}")/../image-builder/builder/aura_stage1.py
  check "kernel is 7.3 (edge)" bash -c '[[ $1 == 7.3.*-ARCH ]]' _ "$kver"
  check "aura stage 1 in the payload (aura-try, one config block, STACKBOT)" \
    python3 "$aura_check" stage1 "$work/x/esp/aurora/stage1.bin"
  check "aura stage 2 on the ESP (m1n1/boot.bin carries aura-try)" \
    python3 "$aura_check" stage2 "$work/x/esp/m1n1/boot.bin"
  echo "kernel commit: $(cat "$m/usr/share/doc/linux-aurora/smartroom-kernel-commit" 2>/dev/null)"
  echo "aura commit: $(jq -r .source_commit "$m/usr/share/doc/aura/build-qualification.json" 2>/dev/null)"
  echo "build-info: $(paste -sd' ' "$m/usr/share/smartroomos/build-info" 2>/dev/null)"
  check "build-info names the aura boot chain" grep -q '^bootloader=aura ' "$m/usr/share/smartroomos/build-info"
  check "kernel commit recorded in /usr/share/doc/linux-aurora/smartroom-kernel-commit" \
    grep -Eqx '[0-9a-f]{40}' "$m/usr/share/doc/linux-aurora/smartroom-kernel-commit"
  # With the encoders' auxiliary DMA blocks enabled, apple-ave-dma keeps the
  # VENC power domains on, and after the first session's Halt the encoder
  # firmware never boots again. The tree aura loads is the copy in boot.bin.
  j475c=$(find "$m/usr/lib/modules/$kver" -name 't6021-j475c.dtb' 2>/dev/null | head -n 1)
  check "m1n1/boot.bin carries the kernel package's j475c device tree" python3 -c '
import sys
sys.exit(open(sys.argv[2], "rb").read() not in open(sys.argv[1], "rb").read())' "$work/x/esp/m1n1/boot.bin" "$j475c"
  for node in video-codec@40d100000 video-codec@507100000; do
    check "j475c device tree: encoder $node okay" \
      test "$(fdtget -t s "$j475c" "/soc/$node" status 2>/dev/null)" = okay
  done
  for node in dma-controller@40d020000 dma-controller@507020000; do
    check "j475c device tree: encoder auxiliary DMA $node disabled" \
      test "$(fdtget -t s "$j475c" "/soc/$node" status 2>/dev/null)" = disabled
  done
  j475c_disp=$(dirname -- "${BASH_SOURCE[0]}")/../image-builder/builder/j475c_display_dtb.py
  if out=$(python3 "$j475c_disp" "$j475c" 2>&1); then
    pass "j475c device tree: $out"
  else
    failed "j475c device tree multi-display topology: $out"
  fi
  # The SMC sensor tree: the driver discovers the temperature keys only when
  # the tree lists no temperature channel of its own, so TH0x must be gone.
  hwmon=/soc/smc@2a2400000/hwmon
  echo "j475c SMC hwmon: $(fdtget -l "$j475c" "$hwmon" 2>/dev/null | paste -sd' ' -)"
  check "j475c device tree: SMC hwmon discovers temperatures" fdtget "$j475c" "$hwmon" apple,discover-temperatures
  check "j475c device tree: no shared temperature-TH0x channel" \
    bash -c '! fdtget -l "$1" "$2" | grep -q "^temperature-"' _ "$j475c" "$hwmon"
  check "j475c device tree: thermal pressure key mTPL" \
    test "$(fdtget -t s "$j475c" "$hwmon" apple,thermal-pressure-key 2>/dev/null)" = mTPL
  for key in PHPC PSVR PSVC PPSR PPMC PC10 PC12 PC20 PC22; do
    check "j475c device tree: SMC power key $key" \
      test "$(fdtget -t s "$j475c" "$hwmon/power-$key" apple,key-id 2>/dev/null)" = "$key"
  done
  ave_ko=$(find "$m/usr/lib/modules/$kver" -name 'apple-ave.ko*' 2>/dev/null | head -n 1)
  echo "apple-ave module: ${ave_ko#"$m"}"
  check "apple-ave usage counter in the kernel (busy_ns, active_sessions, frames attributes)" bash -c '
    case $1 in
      *.zst) d="zstd -dc" ;; *.xz) d="xz -dc" ;; *.gz) d="gzip -dc" ;; *) d=cat ;;
    esac
    s=$($d "$1" | strings -a)
    for a in busy_ns active_sessions frames; do grep -qx "$a" <<<"$s" || exit 1; done' _ "$ave_ko"
  # The 7.3 kernel names its GPU driver "aurora". A Mesa that only knows
  # "asahi" cannot open it, and Hyprland aborts at start, screen or not.
  gpu_ko=$(find "$m/usr/lib/modules/$kver" -path '*/gpu/drm/asahi/*.ko*' 2>/dev/null | head -n 1)
  gallium=$(ls "$m"/usr/lib/libgallium-*.so 2>/dev/null | head -n 1)
  echo "GPU module: ${gpu_ko#"$m"}; Mesa: ${gallium#"$m"} ($(cd "$m/var/lib/pacman/local" && ls -d mesa-aurora-[0-9]* 2>/dev/null))"
  pair=$(dirname -- "${BASH_SOURCE[0]}")/../image-builder/builder/gpu_mesa_pair.py
  if out=$(python3 "$pair" "$gpu_ko" "$gallium" 2>&1); then
    pass "Mesa opens the kernel's GPU driver (${out#kernel GPU driver: })"
  else
    failed "Mesa opens the kernel's GPU driver: $out"
  fi
  hypr=$m/usr/share/smartroomos/hypr
  check "cursor invisible in hyprland.conf (usr/share/smartroomos/hypr)" awk '
    /^[[:space:]]*cursor[[:space:]]*\{/ { s = 1; next }
    s && /^[[:space:]]*\}/ { s = 0 }
    s && /^[[:space:]]*invisible[[:space:]]*=[[:space:]]*true[[:space:]]*$/ { found = 1 }
    END { exit !found }' "$hypr/hyprland.conf"
  check "cursor invisible in hyprland.lua (usr/share/smartroomos/hypr)" \
    grep -Eq '^[[:space:]]*cursor[[:space:]]*=[[:space:]]*\{[^}]*invisible[[:space:]]*=[[:space:]]*true' "$hypr/hyprland.lua"
  # No local shell or root from a classroom keyboard; see the script's header.
  lockdown=$(bash "$(dirname -- "${BASH_SOURCE[0]}")/room-lockdown-check" "$m" 2>&1)
  lockdown_rc=$?
  grep -v -e '^ROOM LOCKDOWN ' <<<"$lockdown"
  fails=$((fails + $(grep -c '^FAIL ' <<<"$lockdown")))
  (( lockdown_rc == 0 )) || grep -q '^FAIL ' <<<"$lockdown" || failed "room-lockdown-check did not run: $lockdown"
  browser=$(awk '$1 ~ /chromium/ { print $1; exit }' "$(dirname -- "${BASH_SOURCE[0]}")/room/packages")
  echo "browser packages: $(cd "$m/var/lib/pacman/local" && ls -d *chromium* 2>/dev/null | paste -sd' ' -)"
  check "room browser $browser installed (room/packages)" test -n "$(ls -d "$m/var/lib/pacman/local/$browser"-[0-9]* 2>/dev/null)"
  for other in chromium chromium-smartroom omarchy-chromium-bin; do
    [[ $other == "$browser" ]] && continue
    check "not installed: $other (the room browser is $browser)" test -z "$(ls -d "$m/var/lib/pacman/local/$other"-[0-9]* 2>/dev/null)"
  done
  check "/usr/bin/chromium is executable (the agent looks for it there)" chroot "$m" test -x /usr/bin/chromium
  esp_bytes=$(find "$work/x/esp" -type f -printf '%s\n' | awk '{ s += $1 } END { print s + 0 }')
  echo "ESP tree bytes: $esp_bytes of 524288000"
  nm=$m/etc/NetworkManager/system-connections/smartroom-wired.nmconnection
  check "wired profile present (AQC113 needs accept-all-mac-addresses)" test -f "$nm"
  check "wired profile is root's, mode 0600 (NetworkManager ignores it otherwise)" test "$(stat -c '%u:%g %a' "$nm" 2>/dev/null)" = "0:0 600"
  check "wired profile: [ethernet] accept-all-mac-addresses=1" \
    test "$(awk '/^\[/ { s = $0 } s == "[ethernet]" && $0 == "accept-all-mac-addresses=1" { print "yes" }' "$nm" 2>/dev/null)" = yes
  # The room comes back after a power cut: the Studio's power-on policy is set at every boot.
  while IFS= read -r line; do
    echo "$line"
    [[ $line == FAIL* ]] && fails=$((fails + 1))
  done < <(bash "$(dirname -- "${BASH_SOURCE[0]}")/ac-power-check" "$m" "$kver")
  check "sudoers.d/smartroomcontroller root's, 0440" test "$(stat -c '%u:%g %a' "$m/etc/sudoers.d/smartroomcontroller" 2>/dev/null)" = "0:0 440"
  check "Limine name: TARGET_OS_NAME=\"SmartRoom Firmware\"" grep -qx 'TARGET_OS_NAME="SmartRoom Firmware"' "$m/etc/default/limine"
  # The leaf rewrites /etc/default/limine at first boot and keeps only the OS
  # name. The checksum switch has to be the drop-in, which that rewrite does
  # not touch, and the defaults file must not turn checksums back on.
  check "Limine file checksums off, where first boot leaves it: etc/limine-entry-tool.d/zz-smartroom-firmware.conf" \
    grep -qx 'ENABLE_VERIFICATION=no' "$m/etc/limine-entry-tool.d/zz-smartroom-firmware.conf"
  check "Limine defaults do not turn file checksums back on" \
    bash -c '! grep -qx "ENABLE_VERIFICATION=yes" "$1"' _ "$m/etc/default/limine"
  check "Limine entries carry no checksum" bash -c '! grep -qE "^ *[a-z_]*path: .*#[0-9a-f]{128}" "$1"' _ "$m/boot/efi/limine.conf"
  check "panic=10 survives in /etc/default/grub (GRUB_CMDLINE_LINUX_DEFAULT)" \
    grep -Eq '^GRUB_CMDLINE_LINUX_DEFAULT="(.*[[:space:]])?panic=10([[:space:]].*)?"$' "$m/etc/default/grub"
  check "panic=10 is on the Limine command line the UKI boots" \
    bash -c 'printf "%s\n" "$1" | grep -Eq "(^|[[:space:]])panic=10([[:space:]]|$)"' _ "$cmdline"
  # Never wait at boot, reboot on every failure (SmartRoom Firmware WS1).
  check "Limine menu timeout: 0 (no menu a held key could keep open)" \
    test "$(sed -n 's/^timeout: //p' "$m/boot/efi/limine.conf")" = 0
  for word in oops=panic softlockup_panic=1 systemd.watchdog_sec=30; do
    check "$word is on the Limine command line the UKI boots" \
      bash -c 'printf "%s\n" "$1" | grep -Fq -- " $2"' _ " $cmdline" "$word"
  done
  check "systemd watchdog drop-in (RuntimeWatchdogSec, CrashAction=reboot)" \
    bash -c 'grep -q "^RuntimeWatchdogSec=" "$1" && grep -qx "CrashAction=reboot" "$1"' _ "$m/etc/systemd/system.conf.d/smartroomos-watchdog.conf"
  check "panic/oops/hung-task sysctls" grep -q 'kernel.hung_task_panic' "$m/etc/sysctl.d/10-smartroomos-panic.conf"
  check "initramfs safety hook installed and in the mkinitcpio hooks" \
    bash -c 'test -f "$1/usr/lib/initcpio/install/smartroomos-safety" && test -f "$1/usr/lib/initcpio/hooks/smartroomos-safety" && grep -q smartroomos-safety "$1/etc/mkinitcpio.conf.d/zz-smartroomos-safety.conf"' _ "$m"
  check "integrity check on boot, periodic timer and rollback command" \
    bash -c 'test -L "$1/multi-user.target.wants/smartroomos-integrity.service" && test -L "$1/timers.target.wants/smartroomos-integrity-periodic.timer" && test -L "$1/timers.target.wants/smartroom-rollback-mark-good.timer" && test -x "$2/usr/local/sbin/smartroom-rollback"' _ "$m/etc/systemd/system" "$m"
  meta=$(dirname -- "$zip")/installer_data.json
  if [[ -f $meta ]]; then
    check "picker and stub name: installer_data.json says SmartRoom Firmware" \
      test "$(jq -r '[.os_list[] | .name, .default_os_name] | unique | join(",")' "$meta")" = "SmartRoom Firmware"
  else
    failed "no installer_data.json beside $zip (the picker and stub name)"
  fi
  check "smartroom-boot-os and aurora-bless installed" test -x "$m/usr/bin/smartroom-boot-os" -a -x "$m/usr/bin/aurora-bless"
  check "Limine entry says SmartRoom Firmware" grep -qx '/+SmartRoom Firmware' "$m/boot/efi/limine.conf"
  # The Recovery app 1TR runs (esp/aurora/recovery, staged unchanged to the stub).
  if out=$(python3 "$(dirname -- "${BASH_SOURCE[0]}")/recovery-branding" app "$work/x/esp/aurora/recovery" 2>&1); then
    pass "Recovery app (1TR) shows SmartRoom Firmware, ${out#no user-visible Omarchy: }"
  else
    failed "Recovery app (1TR) is not the SmartRoom build or still shows Omarchy:"
    sed 's/^/  /' <<<"$out" | head -n 40
  fi
  check "ESP install.conf: encrypt=0" grep -qx 'encrypt=0' "$m/boot/efi/omarchy/install.conf"
  check "sshd enabled" test -L "$wants/sshd.service"
  check "SmartRoom first boot enabled" test -L "$wants/smartroomos-firstboot.service"
  check "SmartRoom first boot runs after Omarchy's" grep -q 'After=omarchy-mac-first-boot.service' "$m/etc/systemd/system/smartroomos-firstboot.service.d/10-after-omarchy-first-boot.conf"
  check "omarchy-mac-first-boot enabled" test -L "$wants/omarchy-mac-first-boot.service"
  check "timezone America/Chicago" test "$(readlink "$m/etc/localtime" | sed 's|^\.\./|/|')" = /usr/share/zoneinfo/America/Chicago
  check "snapshots left to Omarchy" test -e "$m/etc/smartroomos/omarchy-base"
  # Updates and rollback: smartroom-release (aura-try), not the Mini's snapshot tools.
  check "smartroom-release installed" test -x "$m/usr/bin/smartroom-release"
  check "smartroom-release health service enabled at sysinit" test -L "$m/usr/lib/systemd/system/sysinit.target.wants/smartroom-release-health.service" -o -L "$m/etc/systemd/system/sysinit.target.wants/smartroom-release-health.service"
  check "smartroom-release trusts the release key" test -s "$m/usr/share/smartroomos/release-keyring.gpg"
  check "smartroom-release carries the room's identity" grep -qx '/var/lib/smartroomos' "$m/usr/share/smartroomos/release-carry.list"
  check "Room Controller helper is smartroom-release" grep -qx 'Environment=SMARTROOM_SNAPSHOT_HELPER=/usr/bin/smartroom-release' "$m/etc/systemd/system/smartroom-agent.service.d/snapshot-helper.conf"
  for f in usr/local/sbin/smartroomos-snapshot usr/local/bin/smartroomos-snapshot usr/local/sbin/smartroomos-boot-try \
           usr/local/sbin/smartroomos-boot-commit usr/local/sbin/smartroomos-update usr/local/lib/smartroomos/snapshot-lib.sh; do
    check "Mini snapshot/update tool absent: $f" bash -c '[[ ! -e $1 && ! -L $1 ]]' _ "$m/$f"
  done
  check "no owner provisioning armed" test ! -e "$m/var/lib/omarchy/provisioning/pending"
  check "/etc/hosts world-readable (systemd-resolved runs as its own user)" test "$(stat -c %a "$m/etc/hosts")" = 644
  # Adoption rewrites /etc/hosts with the image's own script; run it on a scratch /etc.
  hosts_dest=$(mktemp -d)
  mkdir -p "$hosts_dest/etc"
  cp "$m/etc/hosts" "$hosts_dest/etc/hosts"
  check "adoption leaves /etc/hosts world-readable" bash -c \
    'source "$1/usr/local/lib/smartroomos/install-lib.sh" &&
     SMARTROOMOS_DRY_RUN=1 SMARTROOMOS_AGENT_CONFIG=/nonexistent smartroomos_apply_hostname deskcheck "$2" &&
     grep -q "deskcheck" "$2/etc/hosts" && test "$(stat -c %a "$2/etc/hosts")" = 644' _ "$m" "$hosts_dest"
  rm -rf "$hosts_dest"
  for pkg in omarchy omarchy-settings omarchy-mac sddm plymouth quickshell uwsm; do
    check "not installed: $pkg" test -z "$(ls -d "$m/var/lib/pacman/local/$pkg"-[0-9]* 2>/dev/null)"
  done
  # Release facts: signed release repository only, or dev (the channel).
  if out=$("$(dirname -- "${BASH_SOURCE[0]}")/release-image-check" "$m" 2>&1); then rc=0; else rc=$?; fi
  printf '%s\n' "$out"
  fails=$((fails + $(grep -c '^FAIL' <<<"$out") + (rc != 0 && $(grep -c '^FAIL' <<<"$out") == 0)))
  check "no display manager" test ! -e "$m/etc/systemd/system/display-manager.service" -o "$(readlink "$m/etc/systemd/system/display-manager.service")" = /usr/lib/systemd/system/greetd.service
  for f in etc/limine-entry-tool.d/smartroomos.conf etc/initcpio/install/asahi; do
    check "old boot change absent: $f" test ! -e "$m/$f"
  done
else
  echo "== stock image (owner setup waits on tty1 by design; DHCP does not wait for it)"
  check "sshd not enabled (stock)" test ! -e "$wants/sshd.service"
fi
echo "packages: $(ls "$m/var/lib/pacman/local" | wc -l)"
(( fails == 0 )) && echo "DESK-CHECK PASS" || echo "DESK-CHECK FAIL ($fails)"
exit $(( fails > 0 ))
